generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Project {
  id              Int      @id @default(autoincrement())
  titleKey        String?
  categoryKey     String?
  title           String
  slug            String   @unique
  image           String
  size            String   @default("medium")
  year            String
  catId           String
  client          String?
  duration        String?
  role            String?
  liveLink        String?
  videoUrl        String?
  isFeatured      Boolean  @default(false)
  isActive        Boolean  @default(true)
  overview        String?
  challenge       String?
  solution        String?
  results         Json?
  gallery         Json?
  blocks          Json?
  themeBackground String   @default("black")
  tools           Json?
  keywords        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Content {
  id        String   @id @default("global")
  data      Json
  updatedAt DateTime @updatedAt
}

model Product {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  price       Float
  pdfUrl      String
  image       String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id            Int      @id @default(autoincrement())
  clientName    String
  clientPhone   String
  clientEmail   String   @default("")
  whatsappNumber String   @default("")
  productTitle  String
  price         Float
  paymentMethod String
  trxId         String   @unique
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Attendance {
  id          Int       @id @default(autoincrement())
  userEmail   String
  clockIn     DateTime  @default(now())
  clockOut    DateTime?
  dateString  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AiConversation {
  id        String      @id @default(cuid())
  sessionId String      @unique
  platform  String      @default("WEBSITE") // WEBSITE, MESSENGER
  senderId  String?     // Messenger PSID or Web Session ID
  userName  String?
  userEmail String?
  userPhone String?
  messages  AiMessage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String         // USER, AI, SYSTEM
  content        String
  metadata       Json?          // Stores price quotes, tool output, etc.
  createdAt      DateTime       @default(now())
}

model AiLead {
  id             Int      @id @default(autoincrement())
  clientName     String
  clientPhone    String?
  clientEmail    String?
  platform       String   @default("WEBSITE") // WEBSITE, MESSENGER
  serviceType    String
  estimatedPrice Float?
  notes          String?
  status         String   @default("NEW") // NEW, CONTACTED, CLOSED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Review {
  id         String   @id @default(cuid())
  clientName String
  role       String?
  content    String
  rating     Int      @default(5)
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
